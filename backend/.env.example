# Copy this file to backend/.env and fill in real values.
# .env is gitignored - never commit real credentials.

# Local PostgreSQL. The installed driver is psycopg2 (backend/requirements.txt
# pins psycopg2-binary), so DATABASE_URL must NOT use a "+psycopg" (psycopg3)
# suffix — a plain "postgresql://" URL defaults to the psycopg2 dialect and
# matches what's actually installed. Using "+psycopg" here was a real
# production bug once; see docs/demo-notes.md's Deployment section.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/revenue_recovery

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=
TWILIO_VOICE_FROM=
# TwiML Bin URL used for trial accounts (twiml parameter is restricted on trial).
# TWILIO_VOICE_TWIML_URL=https://handler.twilio.com/twiml/EH...
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Groq (all agent LLM calls — Cart diagnosis, Invoice call-priority scoring,
# ambiguous-case handling). The OpenCode Go gateway used earlier in the build
# is retired; do not revert to it — see docs/model-selection.md's migration
# note and docs/fix-log-llm-provider.md for why.
GROQ_API_KEY=
# Real default used in normal execution
MODEL_NAME=openai/gpt-oss-120b
# Faster/cheaper model used automatically when running under pytest
TEST_MODEL_NAME=openai/gpt-oss-20b
LLM_ENABLED=true

# Razorpay (Phase 5 — real webhook adapter)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# CORS — the deployed frontend's real origin (no trailing slash). Defaults to
# http://localhost:5173 if unset, which is correct for local dev but must be
# set to the real Vercel domain in production, or the browser will block
# every request with "TypeError: Failed to fetch". See docs/demo-notes.md's
# Deployment section for the incident this caused.
FRONTEND_ORIGIN=http://localhost:5173

# Supabase (production database — set this instead of the local URL above
# when deploying; connect via the transaction pooler, not a direct connection)
# DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
